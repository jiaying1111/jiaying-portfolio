# Copy this file to .env.local and replace the placeholders.
# Never commit .env.local or a Supabase secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# China mirror (Tencent Cloud) only — leave empty on Vercel until ICP is issued.
# See docs/china-deploy-tencent.md
NEXT_PUBLIC_ICP_NUMBER=
NEXT_PUBLIC_ICP_URL=https://beian.miit.gov.cn/
